APP_ENV: production
LOG_LEVEL: INFO
FIREBASE_PROJECT_ID: YOUR_FIREBASE_PROJECT_ID
PRELOAD_VISION_MODELS: "true"
VISION_MODEL_ID: openai/clip-vit-base-patch32
DAMAGE_MODEL_ID: openai/clip-vit-base-patch32
IMAGE_SIMILARITY_HIGH_THRESHOLD: "98.2"
IMAGE_SIMILARITY_MODERATE_THRESHOLD: "90.4"
DAMAGE_MIN_CONFIDENCE: "0.74"
MAX_IMAGE_BYTES: "10485760"
MAX_LISTING_IMAGES: "8"
MAX_PDF_BYTES: "10485760"
MAX_PDF_PAGES: "30"
GEMINI_MODEL: gemini-3.5-flash-lite
AGREEMENT_PROVIDER_TIMEOUT_SECONDS: "45"
AGREEMENT_PROVIDER_BATCH_SIZE: "12"
OCR_MIN_EMBEDDED_TEXT_CHARS: "40"
OCR_LANGUAGE: eng
OCR_TIMEOUT_SECONDS: "20"
MAX_AGREEMENT_CLAUSES: "100"
MAX_AGREEMENT_TEXT_CHARS: "120000"
