# Never commit real values. Copy the relevant values into local ignored env files.

# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
PRELOAD_VISION_MODELS=false
MAX_IMAGE_BYTES=10485760
MAX_LISTING_IMAGES=8
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=30

# Firebase Admin (use Application Default Credentials or an ignored credential path)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SEED_USER_PASSWORD=

# Flutter Firebase configuration (pass with --dart-define; do not commit local values)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Agreement simplification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AGREEMENT_PROVIDER_TIMEOUT_SECONDS=45
AGREEMENT_PROVIDER_BATCH_SIZE=12
TESSERACT_CMD=
OCR_MIN_EMBEDDED_TEXT_CHARS=40
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=20
MAX_AGREEMENT_CLAUSES=100
MAX_AGREEMENT_TEXT_CHARS=120000

# Vision model and calibrated thresholds
VISION_MODEL_ID=openai/clip-vit-base-patch32
BAKED_CLIP_MODEL_ID=
IMAGE_SIMILARITY_HIGH_THRESHOLD=
IMAGE_SIMILARITY_MODERATE_THRESHOLD=
DAMAGE_MODEL_ID=openai/clip-vit-base-patch32
DAMAGE_MIN_CONFIDENCE=

# Flutter compile-time configuration (pass with --dart-define)
AI_API_BASE_URL=http://10.0.2.2:8000
